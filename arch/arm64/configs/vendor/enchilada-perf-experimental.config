# OnePlus 6 experimental I/O and network feature availability.
# Opt-in features only: do not change default TCP congestion control,
# qdisc, blk-mq scheduler, filesystem barriers or CPU frequencies.
#
# Storage: BFQ already exists in the sdm845 config. Enable alternative
# blk-mq schedulers for measurement before choosing a device default.
CONFIG_MQ_IOSCHED_DEADLINE=y
CONFIG_MQ_IOSCHED_KYBER=y
#
# Network: allow evaluation of FQ-CoDel/FQ and upstream 4.19 BBR v1.
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_SCH_FQ=y
# TCP_CONG_ADVANCED is a gate around TCP_CONG_BBR in 4.19.
# Preserve CUBIC as the default instead of switching all sockets to BBR.
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_CUBIC=y
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_CUBIC=y
#
# AxIPSet uses the *existing, audited* Netfilter ipset ABI as its data
# plane. No second packet-path hook, copy of hash tables or daemon.
CONFIG_IP_SET=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_NET=y
CONFIG_IP_SET_HASH_IPPORT=y
CONFIG_IP_SET_HASH_NETPORT=y
CONFIG_IP_SET_LIST_SET=y
CONFIG_NETFILTER_XT_SET=y
CONFIG_NET_EMATCH_IPSET=y
